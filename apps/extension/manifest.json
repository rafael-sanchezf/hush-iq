{
  "manifest_version": 3,
  "name": "Hush IQ",
  "version": "0.1.0",
  "description": "How loud the NYC apartment you are looking at will be, for the way you sleep. Reads the listing only when you click.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Score this listing with Hush IQ",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "permissions": ["activeTab", "scripting", "sidePanel", "storage", "contextMenus"],
  "host_permissions": [
    "https://*.streeteasy.com/*",
    "https://*.zillow.com/*",
    "https://*.apartments.com/*",
    "https://*.craigslist.org/*",
    "https://*.zillowstatic.com/*",
    "https://hush-iq-api.vercel.app/*"
  ]
}
