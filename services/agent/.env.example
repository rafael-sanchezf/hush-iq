# Copy to .env (gitignored). With no key the reader runs the basic reader (no model), labelled ai.mode "basic".
MODEL_API_KEY=
MODEL_API_BASE_URL=https://api.meta.ai/v1
MODEL_API_MODEL=muse-spark-1.3
# The score API: the hosted one, or a local packages/model server (uvicorn noise_score.api:app --port 8000).
HUSH_SCORE_URL=https://hush-iq-api.vercel.app
# Agent turns per listing.
READER_TURNS=8
# HOUSE_AI=off turns the house key off (the basic reader, unless a caller brings a key). READER_MODE=mock is the
# older name for the same switch. READER_SCORE=off skips GeoSearch and scoring.
HOUSE_AI=on
# Caller keys for the command line and the eval only (--provider openai|anthropic); the server never reads them.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
