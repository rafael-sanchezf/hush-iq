# Copy to .env (gitignored). With no key the reader runs on the offline mock model, labelled mode "mock".
MODEL_API_KEY=
MODEL_API_BASE_URL=https://api.meta.ai/v1
MODEL_API_MODEL=muse-spark-1.3
# The score API: the hosted one, or a local packages/model server (uvicorn noise_score.api:app --port 8000).
HUSH_SCORE_URL=https://hush-iq-api.vercel.app
# Agent turns per listing.
READER_TURNS=8
# READER_MODE=mock forces the mock model with a key present; READER_SCORE=off skips GeoSearch and scoring.
