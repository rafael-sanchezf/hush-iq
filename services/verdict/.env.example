# Copy to .env (gitignored). With no key the template writes every paragraph.
# Muse Spark Open on Baseten, the default writer when set.
BASETEN_API_KEY=
# Muse Spark 1.3 on the Meta Model API, the second backend.
MODEL_API_KEY=
# auto (default: Baseten if its key is set, then Meta) | muse-spark-open | muse-spark-1.3 | template
VERDICT_BACKEND=auto
# Seconds per model call; a timeout falls back to the template at once. Live calls take 6 to 13 s.
VERDICT_TIMEOUT_S=25
# Reasoning tokens count against this; at effort low a paragraph used up to 3,700.
VERDICT_MAX_TOKENS=6000
# Meta Model API only: minimal | low | medium | high | xhigh (none is refused, the model always reasons).
VERDICT_REASONING_EFFORT=low
